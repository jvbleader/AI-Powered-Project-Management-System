# Azure account / resource placement
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=flowpilot-prod-rg
AZURE_LOCATION=southeastasia

# Azure Container Registry
# Must be globally unique, 5-50 chars, lowercase letters and numbers only.
AZURE_ACR_NAME=flowpilotprodacr

# Azure Container Apps
AZURE_LOG_ANALYTICS_WORKSPACE=flowpilot-prod-law
AZURE_CONTAINERAPPS_ENVIRONMENT=flowpilot-prod-env
AZURE_MANAGED_IDENTITY_NAME=flowpilot-prod-mi
AZURE_FRONTEND_APP_NAME=flowpilot-frontend
AZURE_BACKEND_APP_NAME=flowpilot-backend
AZURE_ROUTE_CONFIG_NAME=flowpilot-public

# Azure Database for MySQL Flexible Server
# Server name must be globally unique.
AZURE_MYSQL_SERVER_NAME=flowpilot-prod-mysql
AZURE_MYSQL_DATABASE=flowpilot
AZURE_MYSQL_ADMIN_USERNAME=flowpilotadmin
AZURE_MYSQL_ADMIN_PASSWORD=replace-with-strong-password
AZURE_MYSQL_SKU=Standard_B1ms
AZURE_MYSQL_TIER=Burstable
AZURE_MYSQL_VERSION=8.0
AZURE_MYSQL_STORAGE_GB=32
# 0.0.0.0 allows access from Azure resources. Tighten later with private networking.
AZURE_MYSQL_PUBLIC_ACCESS=0.0.0.0

# Azure Managed Redis
# Cluster name must be globally unique.
AZURE_REDIS_CLUSTER_NAME=flowpilot-prod-redis
AZURE_REDIS_SKU=Balanced_B0
AZURE_REDIS_CAPACITY=1
AZURE_REDIS_DATABASE_NAME=default

# Azure Storage for avatars
# Must be globally unique, 3-24 chars, lowercase letters and numbers only.
AZURE_STORAGE_ACCOUNT_NAME=flowpilotprodsa
AZURE_STORAGE_CONTAINER_NAME=avatars

# App secrets
OPENAI_API_KEY=sk-your-openai-api-key
JWT_SECRET=replace-with-a-long-random-secret

# Database init jobs
AZURE_DB_MIGRATE_JOB_NAME=flowpilot-db-migrate
AZURE_DB_SEED_JOB_NAME=flowpilot-db-seed
AZURE_RUN_DEMO_SEED=false

# Images
BACKEND_IMAGE_REPOSITORY=flowpilot-backend
FRONTEND_IMAGE_REPOSITORY=flowpilot-frontend
DB_SEED_IMAGE_REPOSITORY=flowpilot-db-seed
BACKEND_IMAGE_TAG=
FRONTEND_IMAGE_TAG=
DB_SEED_IMAGE_TAG=

# Container resources
BACKEND_CPU=1.0
BACKEND_MEMORY=2.0Gi
BACKEND_MIN_REPLICAS=1
BACKEND_MAX_REPLICAS=3
BACKEND_WORKERS=1

FRONTEND_CPU=0.5
FRONTEND_MEMORY=1.0Gi
FRONTEND_MIN_REPLICAS=1
FRONTEND_MAX_REPLICAS=3

# One-shot DB init job resources
DB_JOB_CPU=0.5
DB_JOB_MEMORY=1.0Gi
DB_JOB_TIMEOUT=1800
