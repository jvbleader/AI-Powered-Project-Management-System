# =============================================================================
# Frontend .env — Next.js only (no secrets)
# NEXT_PUBLIC_* is exposed to the browser
# API_BASE_URL_INTERNAL is server-side only (container → backend)
# =============================================================================

# --- Browser (public) ---
# Dev (no nginx): http://localhost:8000
# Prod (behind nginx): same-origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PORT=8000

# --- Server-side (Next.js → backend service name) ---
API_BASE_URL_INTERNAL=http://backend:8000
