# =============================================================================
# Root .env — Docker Compose / infrastructure
# =============================================================================

# --- Host ---
TZ=Asia/Ho_Chi_Minh

# --- MySQL (container network) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=flowpilot
MYSQL_USER=flowpilot
MYSQL_PASSWORD=change-me-db-password

# --- Host-published ports ---
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- Public reverse proxy (production compose) ---
PUBLIC_APP_URL=http://localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NEXT_PUBLIC_API_BASE_URL=same-origin
CORS_ORIGINS=http://localhost,http://127.0.0.1

# --- In-container listen ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend process (production image) ---
BACKEND_WORKERS=4
