# =============================================================================
# Backend .env — app secrets & process settings
# MySQL user/password/database/host-port come from root .env
# Settings builds DATABASE_URL automatically
# =============================================================================

# --- App ---
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- MySQL connection target (credentials live in root .env) ---
# Docker Compose overrides: MYSQL_HOST=mysql, MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# --- Security / JWT ---
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000,http://frontend:3000,http://host.docker.internal:3000

# --- AI ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Azure Storage ---
AZURE_STORAGE_CONNECTION_STRING=change-me-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=avatars
